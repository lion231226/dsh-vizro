{
  "name": "dsh-vizro",
  "version": "0.3.2",
  "description": "Build, validate and preview Vizro dashboards inside DeepSeek Harness: six native tools over a Python sidecar, six skills, and a workbench panel. No MCP server.",
  "type": "module",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "sidecar",
    "skills",
    "evals",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SPEC.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:sidecar": "node --test \"test/sidecar.test.mjs\"",
    "smoke:sidecar": "node tools/smoke-sidecar.mjs",
    "eval": "node evals/run.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "vizro",
    "dashboard",
    "data-visualization",
    "plotly",
    "pydantic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lion231226/dsh-vizro.git"
  },
  "homepage": "https://github.com/lion231226/dsh-vizro#readme",
  "bugs": {
    "url": "https://github.com/lion231226/dsh-vizro/issues"
  },
  "author": "lion231226",
  "license": "MIT"
}


